{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node", "react", "nativewind/types"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "*.d.ts",
    "nativewind-env.d.ts",
    "integration/**/*.ts",
    "playwright.integration.config.ts"
  ]
}
