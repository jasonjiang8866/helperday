{
  "expo": {
    "name": "Helperday",
    "slug": "helperday",
    "scheme": "helperday",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.helperday.app" },
    "android": { "package": "com.helperday.app" },
    "web": { "bundler": "metro", "output": "single", "name": "Helperday" },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
